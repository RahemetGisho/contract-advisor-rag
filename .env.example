# Copy to .env (never commit .env). Get a free key at https://console.groq.com
GROQ_API_KEY=

# Access to this API. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Several keys may be comma-separated. Keys shorter than 16 characters are refused.
# With no key set, /query is refused (the API fails closed).
API_KEYS=
# Local development only: run /query without a key.
# RAG_API_REQUIRE_KEY=false

# Optional overrides of configs/config.yaml, handy for offline development:
# RAG_LLM_PROVIDER=mock
# RAG_EMBEDDING_PROVIDER=tfidf
# RAG_VECTOR_STORE_DIR=data/processed/chroma_tfidf
